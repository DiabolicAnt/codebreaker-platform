# Copiar a .env. Nunca subir claves ni archivos de credenciales al repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_MAX_TOKENS=2048
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Almacenamiento local de desarrollo. Las rutas relativas parten de la carpeta de la API.
FLASHCARDS_DB_PATH=data/flashcards.sqlite3
FSRS_DESIRED_RETENTION=0.9

# Identidad obligatoria para evaluar y acceder a flashcards, incluso con SQLite.
FIREBASE_PROJECT_ID=code-breaker-27518
# Ruta al JSON local, fuera del repositorio. Vacía: Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CHECK_REVOKED=true
FIREBASE_TIMEOUT_SECONDS=10
# Sólo para una sesión explícita con emuladores; nunca en un despliegue real.
FIREBASE_USE_EMULATORS=false

# sqlite para desarrollo aislado; firestore para usar la base de Firebase.
FLASHCARDS_BACKEND=sqlite
FIRESTORE_DATABASE_ID=(default)
# Timeout por lectura. Las transacciones del SDK tienen sus propios reintentos.
FIRESTORE_TIMEOUT_SECONDS=10

# Historial obligatorio para /evaluator/analyze y /evaluator/sessions.
EVALUATIONS_BACKEND=sqlite
EVALUATIONS_DB_PATH=data/evaluations.sqlite3
